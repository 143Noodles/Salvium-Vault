+void tools::wallet2::upgrade_legacy_return_metadata()
+{
+  if (!m_return_scan_hints.empty() || !m_return_spend_metadata.empty())
+    return;
+
+  for (const auto &entry : m_return_output_info)
+  {
+    const crypto::public_key &return_key = entry.first;
+    const carrot::return_output_info_t &roi = entry.second;
+
+    if (carrot::is_return_spend_metadata_complete(roi))
+    {
+      m_return_spend_metadata[return_key] = carrot::return_spend_metadata_t(
+        return_key,
+        roi.K_spend_pubkey,
+        roi.key_image,
+        roi.sum_g,
+        roi.sender_extension_t
+      );
+    }
+
+    if (roi.K_o == crypto::null_pkey)
+      continue;
+
+    cryptonote::transaction_type origin_tx_type = cryptonote::transaction_type::UNSET;
+    crypto::public_key origin_tx_pub_key = crypto::null_pkey;
+    uint64_t origin_output_index = 0;
+    auto transfer_it = m_pub_keys.find(roi.K_o);
+    if (transfer_it != m_pub_keys.end() && transfer_it->second < m_transfers.size())
+    {
+      const auto &origin_td = m_transfers[transfer_it->second];
+      const cryptonote::transaction_prefix *origin_tx =
+          tools::wallet::get_effective_transfer_tx(origin_td, *this);
+      origin_tx_type = origin_tx->type;
+      origin_tx_pub_key =
+          cryptonote::get_tx_pub_key_from_extra(*origin_tx, origin_td.m_pk_index);
+      origin_output_index = origin_td.m_internal_output_index;
+    }
+
+    m_return_scan_hints[return_key] = carrot::return_scan_hint_t(
+      roi.input_context,
+      roi.K_o,
+      return_key,
+      origin_tx_type,
+      origin_tx_pub_key,
+      origin_output_index
+    );
+  }
+}
+
+void tools::wallet2::sync_return_metadata_from_account()
+{
+  m_return_output_info.clear();
+  for (const auto &output_info : m_account.get_return_output_map_ref())
+    m_return_output_info.insert({output_info.first, output_info.second});
+
+  m_return_scan_hints.clear();
+  for (const auto &scan_hint : m_account.get_return_scan_hint_map_ref())
+    m_return_scan_hints.insert({scan_hint.first, scan_hint.second});
+
+  m_return_spend_metadata.clear();
+  for (const auto &spend_metadata : m_account.get_return_spend_metadata_map_ref())
+    m_return_spend_metadata.insert({spend_metadata.first, spend_metadata.second});
+}
+
+void tools::wallet2::materialize_return_spend_metadata(
+    const crypto::public_key &return_key,
+    const carrot::return_scan_hint_t &scan_hint,
+    const crypto::public_key &change_output_key,
+    const crypto::public_key &canonical_spend_pubkey,
+    const crypto::key_image &key_image,
+    const crypto::secret_key &sender_extension_g,
+    const crypto::secret_key &sender_extension_t)
+{
+  std::unordered_map<crypto::public_key, carrot::return_output_info_t>
+      updated_roi;
+  std::unordered_map<crypto::public_key, carrot::return_spend_metadata_t>
+      updated_spend_metadata;
+
+  updated_roi[return_key] = carrot::return_output_info_t(
+      scan_hint.input_context, scan_hint.K_o, change_output_key,
+      canonical_spend_pubkey, key_image, sender_extension_g,
+      sender_extension_t);
+  updated_spend_metadata[return_key] = carrot::return_spend_metadata_t(
+      return_key, canonical_spend_pubkey, key_image, sender_extension_g,
+      sender_extension_t);
+
+  m_account.insert_return_output_info(updated_roi);
+  m_account.insert_return_spend_metadata(updated_spend_metadata);
+  m_return_output_info[return_key] = updated_roi.begin()->second;
+  m_return_spend_metadata[return_key] = updated_spend_metadata.begin()->second;
+  invalidate_effective_ki_cache();
+}
