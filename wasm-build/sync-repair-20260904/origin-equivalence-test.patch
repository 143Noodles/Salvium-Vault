+  std::string test_return_origin_lookup() {
+    const auto original = m_wallet->m_transfers;
+    size_t comparisons = 0;
+    std::vector<crypto::public_key> keys{crypto::null_pkey};
+    for (const auto &entry : m_wallet->get_account().get_return_output_map_ref()) keys.push_back(entry.first);
+    visit_confirmed_return_origins([&](const crypto::public_key &key, const ReturnOriginCandidate &) { keys.push_back(key); return false; });
+    std::vector<carrot::return_scan_hint_t> hints;
+    for (const auto &entry : m_wallet->get_account().get_return_scan_hint_map_ref()) hints.push_back(entry.second);
+    for (const auto &td : original) {
+      const auto *tx = tools::wallet::get_effective_transfer_tx(td, *m_wallet);
+      if (!tx) continue;
+      carrot::return_scan_hint_t hint{};
+      hint.origin_tx_type = tx->type;
+      hint.origin_output_index = td.m_internal_output_index;
+      hint.origin_tx_pub_key = cryptonote::get_tx_pub_key_from_extra(*tx, td.m_pk_index);
+      hints.push_back(hint);
+      hint.origin_tx_pub_key = cryptonote::get_tx_pub_key_from_extra(*tx);
+      hints.push_back(hint);
+      hint.origin_output_index = std::numeric_limits<uint64_t>::max();
+      hints.push_back(hint);
+    }
+    try {
+      for (size_t copies : {size_t(1), size_t(10), size_t(80)}) {
+        m_wallet->m_transfers = original;
+        for (size_t c = 1; c < copies; ++c) m_wallet->m_transfers.insert(m_wallet->m_transfers.end(), original.begin(), original.end());
+        ReturnOriginLookup lookup;
+        for (const auto &key : keys) {
+          const auto expected = reference_transfer_origin(key);
+          const auto actual = find_transfer_origin_candidate_for_return_key(key, &lookup);
+          if (expected != actual) throw std::runtime_error("return origin candidate mismatch");
+          ++comparisons;
+        }
+        for (const auto &hint : hints) {
+          const auto *expected = find_origin_transfer_from_scan_hint(hint);
+          const auto *actual = find_origin_transfer_from_scan_hint(hint, &lookup);
+          if (expected != actual) throw std::runtime_error("return origin hint mismatch");
+          ++comparisons;
+        }
+      }
+      m_wallet->m_transfers = original;
+    } catch (...) { m_wallet->m_transfers = original; throw; }
+    return "{\"success\":true,\"comparisons\":" + std::to_string(comparisons) + "}";
+  }
+  std::string test_return_origin_scale(unsigned copies, unsigned queries) {
+    const auto original_confirmed = m_wallet->m_confirmed_txs;
+    const auto original_runtime = m_wallet->m_runtime_full_txs;
+    auto restore = [&]() {
+      m_wallet->m_confirmed_txs = original_confirmed;
+      m_wallet->m_runtime_full_txs = original_runtime;
+    };
+    try {
+      for (unsigned c = 1; c < copies; ++c) {
+        for (const auto &entry : original_confirmed) {
+          struct { crypto::hash hash; unsigned copy; } material{entry.first, c};
+          crypto::hash key;
+          crypto::cn_fast_hash(&material, sizeof(material), key);
+          m_wallet->m_confirmed_txs.emplace(key, entry.second);
+          const auto full = original_runtime.find(entry.first);
+          if (full != original_runtime.end()) m_wallet->m_runtime_full_txs.emplace(key, full->second);
+        }
+      }
+      std::vector<crypto::public_key> keys;
+      for (unsigned q = 0; q < queries; ++q) {
+        crypto::hash hash;
+        crypto::cn_fast_hash(&q, sizeof(q), hash);
+        crypto::public_key key;
+        std::memcpy(&key, &hash, sizeof(key));
+        keys.push_back(key);
+      }
+      auto started = std::chrono::steady_clock::now();
+      std::vector<std::optional<ReturnOriginCandidate>> expected;
+      for (const auto &key : keys) expected.push_back(reference_transfer_origin(key));
+      double original_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count();
+      started = std::chrono::steady_clock::now();
+      ReturnOriginLookup lookup;
+      for (size_t i = 0; i < keys.size(); ++i) {
+        if (find_transfer_origin_candidate_for_return_key(keys[i], &lookup) != expected[i])
+          throw std::runtime_error("scaled origin lookup mismatch");
+      }
+      double indexed_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count();
+      const size_t count = m_wallet->m_confirmed_txs.size();
+      restore();
+      std::ostringstream out;
+      out << "{\"success\":true,\"confirmed\":" << count
+          << ",\"queries\":" << queries << ",\"original_ms\":" << original_ms
+          << ",\"indexed_ms\":" << indexed_ms << "}";
+      return out.str();
+    } catch (...) { restore(); throw; }
+  }
