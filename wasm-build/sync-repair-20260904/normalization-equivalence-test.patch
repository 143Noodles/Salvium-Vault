+  std::string test_normalization_equivalence() {
+    if (!m_wallet || m_wallet->m_transfers.empty())
+      throw std::runtime_error("populated fixture required");
+    const auto base_transfers = m_wallet->m_transfers;
+    const auto base_images = m_wallet->m_key_images;
+    const auto reset = [&]() {
+      m_wallet->m_transfers = base_transfers;
+      m_wallet->m_key_images = base_images;
+      m_wallet->invalidate_effective_ki_cache();
+    };
+    size_t comparisons = 0, invalid_unchanged = 0, collisions = 0;
+    size_t repairs = 0;
+    try {
+      for (size_t target = 0; target < base_transfers.size(); ++target) {
+        for (int scenario = 0; scenario < 11; ++scenario) {
+          reset();
+          auto &td = m_wallet->m_transfers[target];
+          const auto effective = tools::wallet::get_effective_transfer_key_image(td, *m_wallet);
+          if (scenario == 1) m_wallet->m_key_images.erase(effective);
+          if (scenario == 2) td.m_key_image_known = false;
+          if (scenario == 3) td.m_key_image_partial = true;
+          if (scenario == 4) td.m_key_image = crypto::key_image{};
+          if (scenario == 5) m_wallet->m_key_images[effective] = base_transfers.size() + 5;
+          if (scenario == 6) {
+            // Invalid output context with otherwise consistent persisted image.
+            td.m_internal_output_index = std::numeric_limits<uint64_t>::max();
+            if (!tools::wallet::validate_transfer_spend_authority(td, *m_wallet))
+              ++invalid_unchanged;
+          }
+          if (scenario == 7) {
+            td.m_key_image_known = false;
+            m_wallet->m_key_images.erase(effective);
+          }
+          if (scenario == 8) {
+            td.m_key_image_partial = true;
+            m_wallet->m_key_images[effective] = base_transfers.size() + 5;
+          }
+          if (scenario == 9 || scenario == 10) {
+            m_wallet->m_key_images.erase(td.m_key_image);
+            reinterpret_cast<unsigned char *>(&td.m_key_image)[0] ^= 0x80;
+            td.m_key_image_known = true;
+            if (scenario == 9) m_wallet->m_key_images[td.m_key_image] = target;
+          }
+          const auto before_transfers = m_wallet->m_transfers;
+          const auto before_images = m_wallet->m_key_images;
+          size_t reference_count = 0, candidate_count = 0;
+          std::string reference_error, candidate_error;
+          try { reference_count = reference_normalize_effective_key_images(); }
+          catch (const std::exception &e) { reference_error = e.what(); }
+          const auto expected_transfers = m_wallet->m_transfers;
+          const auto expected_images = m_wallet->m_key_images;
+          m_wallet->m_transfers = before_transfers;
+          m_wallet->m_key_images = before_images;
+          m_wallet->invalidate_effective_ki_cache();
+          try { candidate_count = normalize_effective_key_images(); }
+          catch (const std::exception &e) { candidate_error = e.what(); }
+          if (reference_error != candidate_error || reference_count != candidate_count ||
+              expected_images != m_wallet->m_key_images)
+            throw std::runtime_error("normalization result/map mismatch");
+          for (size_t i = 0; i < expected_transfers.size(); ++i) {
+            const auto &a = expected_transfers[i];
+            const auto &b = m_wallet->m_transfers[i];
+            if (a.m_key_image != b.m_key_image || a.m_key_image_known != b.m_key_image_known ||
+                a.m_key_image_partial != b.m_key_image_partial)
+              throw std::runtime_error("normalization transfer mismatch");
+          }
+          ++comparisons;
+          repairs += candidate_count;
+          if (!candidate_error.empty()) ++collisions;
+        }
+      }
+      reset();
+      const auto old_start = std::chrono::steady_clock::now();
+      for (int i = 0; i < 16; ++i) reference_normalize_effective_key_images();
+      const auto old_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - old_start).count();
+      reset();
+      const auto new_start = std::chrono::steady_clock::now();
+      for (int i = 0; i < 16; ++i) normalize_effective_key_images();
+      const auto new_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - new_start).count();
+      reset();
+      std::ostringstream result;
+      result << "{\"comparisons\":" << comparisons << ",\"invalidUnchanged\":" << invalid_unchanged
+             << ",\"repairs\":" << repairs << ",\"collisions\":" << collisions
+             << ",\"referenceMs\":" << old_ms << ",\"candidateMs\":" << new_ms << "}";
+      return result.str();
+    } catch (...) { reset(); throw; }
+  }
